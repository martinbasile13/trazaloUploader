PORT=8787

# Supabase (mismo proyecto que trazaloApp)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Nunca en el frontend. Solo acá.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Account > R2 > Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trazalo-media
# Dominio público atado al bucket (R2 > bucket > Settings > Custom Domains)
R2_PUBLIC_BASE_URL=https://media.trazalo.app

# Origin permitido para las requests del navegador (CORS)
ALLOWED_ORIGIN=https://trazalo.app
